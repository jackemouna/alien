// Copy to LocalSigning.xcconfig for personal local signing overrides.
// This file is only an example and should stay committed.

ALIEN_CODE_SIGN_STYLE = Automatic
ALIEN_DEVELOPMENT_TEAM = YOUR_TEAM_ID

ALIEN_APP_BUNDLE_ID = ai.alien.client
ALIEN_SHARE_BUNDLE_ID = ai.alien.client.share
ALIEN_ACTIVITY_WIDGET_BUNDLE_ID = ai.alien.client.activitywidget
ALIEN_WATCH_APP_BUNDLE_ID = ai.alien.client.watchkitapp
ALIEN_WATCH_EXTENSION_BUNDLE_ID = ai.alien.client.watchkitapp.extension

// Leave empty with automatic signing.
ALIEN_APP_PROFILE =
ALIEN_SHARE_PROFILE =
ALIEN_WATCH_APP_PROFILE =
ALIEN_WATCH_EXTENSION_PROFILE =
