// Default signing values for shared/repo builds.
// Auto-selected local team overrides live in .local-signing.xcconfig (git-ignored).
// Manual local overrides can go in LocalSigning.xcconfig (git-ignored).

#include "Config/Version.xcconfig"

ALIEN_CODE_SIGN_STYLE = Manual
ALIEN_DEVELOPMENT_TEAM = Y5PE65HELJ

ALIEN_APP_BUNDLE_ID = ai.alien.client
ALIEN_SHARE_BUNDLE_ID = ai.alien.client.share
ALIEN_WATCH_APP_BUNDLE_ID = ai.alien.client.watchkitapp
ALIEN_WATCH_EXTENSION_BUNDLE_ID = ai.alien.client.watchkitapp.extension
ALIEN_ACTIVITY_WIDGET_BUNDLE_ID = ai.alien.client.activitywidget

ALIEN_APP_PROFILE = ai.alien.client Development
ALIEN_SHARE_PROFILE = ai.alien.client.share Development

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"
