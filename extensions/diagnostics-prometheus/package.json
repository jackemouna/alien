{
  "name": "@alien/diagnostics-prometheus",
  "version": "2026.5.6",
  "description": "Alien diagnostics Prometheus exporter",
  "repository": {
    "type": "git",
    "url": "https://github.com/alien/alien"
  },
  "type": "module",
  "devDependencies": {
    "@alien/plugin-sdk": "workspace:*"
  },
  "alien": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@alien/diagnostics-prometheus",
      "npmSpec": "@alien/diagnostics-prometheus",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.25"
    },
    "compat": {
      "pluginApi": ">=2026.5.6"
    },
    "build": {
      "alienVersion": "2026.5.6"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
