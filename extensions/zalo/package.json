{
  "name": "@alien/zalo",
  "version": "2026.5.6",
  "description": "Alien Zalo channel plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/alien/alien"
  },
  "type": "module",
  "dependencies": {
    "undici": "8.2.0"
  },
  "devDependencies": {
    "@alien/plugin-sdk": "workspace:*",
    "alien": "workspace:*"
  },
  "peerDependencies": {
    "alien": ">=2026.5.6"
  },
  "peerDependenciesMeta": {
    "alien": {
      "optional": true
    }
  },
  "alien": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "zalo",
      "label": "Zalo",
      "selectionLabel": "Zalo (Bot API)",
      "docsPath": "/channels/zalo",
      "docsLabel": "zalo",
      "blurb": "Vietnam-focused messaging platform with Bot API.",
      "aliases": [
        "zl"
      ],
      "order": 80,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@alien/zalo",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.5.6"
    },
    "build": {
      "alienVersion": "2026.5.6"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
