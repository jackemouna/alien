{
  "name": "@alien/codex",
  "version": "2026.5.6",
  "description": "Alien Codex harness and model provider plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/alien/alien"
  },
  "type": "module",
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.73.0",
    "@openai/codex": "0.128.0",
    "ajv": "^8.20.0",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@alien/plugin-sdk": "workspace:*"
  },
  "alien": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@alien/codex",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.1-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.5.6"
    },
    "build": {
      "alienVersion": "2026.5.6"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
