{
  "name": "@alien/google-meet",
  "version": "2026.5.6",
  "description": "Alien Google Meet participant plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/alien/alien"
  },
  "type": "module",
  "dependencies": {
    "commander": "^14.0.3",
    "typebox": "1.1.37"
  },
  "devDependencies": {
    "@alien/plugin-sdk": "workspace:*",
    "alien": "workspace:*"
  },
  "peerDependencies": {
    "alien": ">=2026.5.6"
  },
  "peerDependenciesMeta": {
    "alien": {
      "optional": true
    }
  },
  "alien": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@alien/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.5.6"
    },
    "build": {
      "alienVersion": "2026.5.6"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
